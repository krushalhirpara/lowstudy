// LowStudy Scalable Relational Database Schema
// Multi-University, Multi-Course, Multi-Semester Law Learning Architecture

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Users & Authentication
model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  fullName       String?
  role           String    @default("STUDENT") // STUDENT, ADMIN, FACULTY, REVIEWER
  universityId   String?
  collegeId      String?
  courseId       String?
  semesterId     String?
  xp             Int       @default(0)
  streakDays     Int       @default(0)
  coins          Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  university     University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  college        College?    @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  course         Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester       Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  
  testAttempts   TestAttempt[]
  bookmarks      Bookmark[]
  wrongAnswers   WrongAnswer[]
  studyProgress  StudyProgress[]
  revisionItems  RevisionItem[]
  studyPlans     StudyPlan[]
  subjectProgress StudentSubjectProgress[]
  verifiedNotes  Note[]      @relation("NoteVerifier")
  verifiedAnswers QuestionAnswer[] @relation("AnswerVerifier")
  aiVerifications AiContent[] @relation("AiVerifier")
  reviewsGiven   ContentReview[]
  answerAttempts AnswerPracticeAttempt[]

  verifiedSyllabi         SyllabusVersion[] @relation("SyllabusVerifier")
  reviewedSyllabusChanges SyllabusChange[]  @relation("SyllabusChangeReviewer")
  auditLogs               AuditLog[]

  @@index([email])
  @@index([role])
  @@index([universityId])
}

// 2. Universities (Institutions)
model University {
  id                     String    @id
  name                   String
  code                   String    @unique
  city                   String
  district               String?
  state                  String    @default("Gujarat")
  type                   String    @default("State Public University")
  established            Int?
  logo                   String?
  officialWebsite        String?
  officialSyllabusSource String?
  status                 String    @default("VERIFIED") // VERIFIED, PENDING_REVIEW
  academicYear           String    @default("2026-27")
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  courses                Course[]
  colleges               College[]
  subjects               Subject[]
  previousPapers         PreviousPaper[]
  mockTests              MockTest[]
  users                  User[]

  syllabusSources        SyllabusSource[]
  syllabusVersions       SyllabusVersion[]
  nyayaContexts          NyayaAIContext[]

  @@index([code])
  @@index([state])
  @@index([city])
}

// 2.1 Colleges (Affiliated Institutions)
model College {
  id                  String    @id
  universityId        String
  name                String
  city                String
  district            String?
  type                String    @default("Grant-in-Aid Law College")
  officialWebsite     String?
  status              String    @default("VERIFIED") // VERIFIED, PENDING_REVIEW
  hasSeparateSyllabus Boolean   @default(false)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  syllabusVersions    SyllabusVersion[]
  users               User[]

  @@index([universityId])
  @@index([city])
  @@index([status])
}

// 3. Courses / Degree Programs (e.g. 3-Yr LLB, 5-Yr BA LLB, LLM)
model Course {
  id             String    @id
  universityId   String
  name           String
  code           String
  totalSemesters Int       @default(6)
  description    String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  university     University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  semesters      Semester[]
  subjects       Subject[]
  previousPapers PreviousPaper[]
  mockTests      MockTest[]
  users          User[]

  syllabusVersions SyllabusVersion[]
  nyayaContexts    NyayaAIContext[]

  @@unique([universityId, code])
  @@index([universityId])
}

// 4. Semesters (Semester 1 to Semester 10)
model Semester {
  id             String    @id
  courseId       String
  semesterNumber Int
  title          String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subjects       Subject[]
  previousPapers PreviousPaper[]
  mockTests      MockTest[]
  users          User[]

  @@unique([courseId, semesterNumber])
  @@index([courseId])
  @@index([semesterNumber])
}

// 5. Subjects
model Subject {
  id              String    @id
  universityId    String
  courseId        String
  semesterId      String
  title           String
  shortCode       String
  category        String    @default("Core Law") // Core Law, Criminal Law, Civil Law, Corporate Law, etc.
  credits         Int       @default(4)
  syllabusVersion String    @default("new") // "new" (BNS 2023) / "old" (IPC 1860)
  color           String    @default("from-blue-600 to-indigo-900")
  description     String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester        Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  
  units           Unit[]
  mcqs            Mcq[]
  previousPapers  PreviousPaper[]
  mockTests       MockTest[]
  subjectProgress StudentSubjectProgress[]

  syllabusSubjects SyllabusSubject[]

  @@unique([semesterId, shortCode, syllabusVersion])
  @@index([universityId])
  @@index([semesterId])
  @@index([category])
  @@index([syllabusVersion])
}

// 6. Units (Modules within a subject)
model Unit {
  id          String    @id
  subjectId   String
  unitNumber  Int
  title       String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  topics      Topic[]

  @@unique([subjectId, unitNumber])
  @@index([subjectId])
}

// 7. Topics (Study topics within units)
model Topic {
  id            String    @id
  unitId        String
  topicNumber   Int       @default(1)
  title         String
  description   String?
  language      String    @default("EN") // EN, GU, HI
  status        String    @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  unit          Unit      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subTopics     SubTopic[]
  notes         Note[]
  legalSections LegalSection[]
  caseLaws      CaseLaw[]
  questions     Question[]
  mcqs          Mcq[]
  studyProgress StudyProgress[]

  @@unique([unitId, title])
  @@index([unitId])
  @@index([status])
}

// 8. Sub Topics (Granular sub-sections)
model SubTopic {
  id         String   @id @default(cuid())
  topicId    String
  orderIndex Int      @default(1)
  title      String
  content    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
}

// 9. Notes (Simple & Detailed Exam Notes)
model Note {
  id            String    @id
  topicId       String
  language      String    @default("EN") // EN, GU, HI
  simpleNotes   String
  detailedNotes String
  keyPoints     String?   // JSON string of key points
  mnemonics     String?   // JSON string of memory aids
  status        String    @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED
  verifiedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  topic         Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  verifiedBy    User?     @relation("NoteVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([language])
  @@index([status])
}

// 10. Legal Sections (Bare Acts: BNS, BNSS, BSA, IPC, CrPC, IEA, Constitution)
model LegalSection {
  id                String    @id
  topicId           String?
  actName           String    // BNS 2023, BNSS 2023, BSA 2023, IPC 1860, Constitution of India, etc.
  sectionNumber     String
  title             String
  titleGu           String?
  content           String
  contentGu         String?
  oldLawSection     String?   // e.g. "IPC Section 302"
  oldLawAct         String?   // e.g. "IPC 1860"
  punishment        String?
  punishmentGu      String?
  bailableStatus    String?   // Bailable, Non-Bailable
  cognizableStatus  String?   // Cognizable, Non-Cognizable
  compoundableStatus String?  // Compoundable, Non-Compoundable
  status            String    @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  topic             Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([actName, sectionNumber])
  @@index([actName])
  @@index([sectionNumber])
  @@index([topicId])
  @@index([status])
}

// 11. Case Laws (Landmark Judicial Precedents)
model CaseLaw {
  id               String    @id
  topicId          String?
  title            String
  citation         String?
  year             Int?
  court            String    @default("Supreme Court of India")
  bench            String?
  subjectName      String?
  keyPrinciple     String
  keyPrincipleGu   String?
  facts            String?
  issues           String?
  argumentsText    String?
  judgment         String?
  ratioDecidendi   String
  ratioDecidendiGu String?
  importance       String    @default("LANDMARK") // LANDMARK, IMPORTANT, REFERENCE
  status           String    @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  topic            Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@index([topicId])
  @@index([title])
  @@index([importance])
  @@index([status])
}

// 12. Questions (Descriptive / Subjective / Problem-based Questions)
model Question {
  id                  String    @id @default(cuid())
  topicId             String
  questionText        String
  questionTextGu      String?
  marks               Int       @default(10)
  difficulty          String    @default("MEDIUM") // EASY, MEDIUM, HARD
  preparationPriority String    @default("HIGH")   // HIGH, MEDIUM, LOW
  pyqFrequency        Int       @default(1)
  questionType        String    @default("DESCRIPTIVE") // DESCRIPTIVE, SHORT, CASE_PROBLEM, ESSAY
  status              String    @default("PUBLISHED") // DRAFT, REVIEW, PUBLISHED, OUTDATED, REJECTED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  previous_year_count Int       @default(0)
  years_asked         String?   // JSON array or comma list, e.g. ["2023", "2024"]
  syllabus_weight     Float     @default(1.0)
  legal_importance    Float     @default(1.0)
  priority_score      Float     @default(0.0) // 0 to 100 composite score
  priority_label      String    @default("Practice") // "Very High Priority", "High Priority", "Important", "Practice"
  why_important       String?   // Evidence-grounded rationale without predictive claims
  isManualPriority    Boolean   @default(false)

  syllabusVersionId   String?
  syllabusStatus      String    @default("CURRENT") // CURRENT, OUTDATED, REVIEW_REQUIRED

  topic               Topic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  syllabusVersion     SyllabusVersion? @relation(fields: [syllabusVersionId], references: [id], onDelete: SetNull)
  answers             QuestionAnswer[]
  paperQuestions      PreviousPaperQuestion[]
  practiceAttempts    AnswerPracticeAttempt[]

  @@index([topicId])
  @@index([difficulty])
  @@index([preparationPriority])
  @@index([priority_label])
  @@index([priority_score])
  @@index([status])
  @@index([syllabusVersionId])
  @@index([syllabusStatus])
}

// 13. Question Answers (Model Answer Structure & Citations)
model QuestionAnswer {
  id                String    @id @default(cuid())
  questionId        String
  language          String    @default("EN") // EN, GU
  answerText        String
  keyPoints         String?   // JSON string
  judicialCitations String?   // JSON string
  modelStructure    String?   // JSON string
  isVerified        Boolean   @default(true)
  verifiedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  question          Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  verifiedBy        User?     @relation("AnswerVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([questionId])
  @@index([language])
}

// 14. MCQs (Multiple Choice Questions)
model Mcq {
  id                  String    @id @default(cuid())
  topicId             String?
  subjectId           String?
  questionText        String
  questionTextGu      String?
  difficulty          String    @default("MEDIUM") // EASY, MEDIUM, HARD
  preparationPriority String    @default("HIGH")   // HIGH, MEDIUM, LOW
  explanation         String
  explanationGu       String?
  status              String    @default("PUBLISHED") // DRAFT, REVIEW_REQUIRED, PUBLISHED, OUTDATED, REJECTED
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  syllabusVersionId   String?
  syllabusStatus      String    @default("CURRENT") // CURRENT, OUTDATED, REVIEW_REQUIRED

  topic               Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subject             Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  syllabusVersion     SyllabusVersion? @relation(fields: [syllabusVersionId], references: [id], onDelete: SetNull)
  
  options             McqOption[]
  mockTestQuestions   MockTestQuestion[]
  testAnswers         TestAnswer[]
  wrongAnswers        WrongAnswer[]

  @@index([topicId])
  @@index([subjectId])
  @@index([difficulty])
  @@index([status])
  @@index([syllabusVersionId])
  @@index([syllabusStatus])
}

// 15. MCQ Options
model McqOption {
  id           String   @id @default(cuid())
  mcqId        String
  optionKey    String   // A, B, C, D
  optionText   String
  optionTextGu String?
  isCorrect    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mcq          Mcq      @relation(fields: [mcqId], references: [id], onDelete: Cascade)

  @@unique([mcqId, optionKey])
  @@index([mcqId])
}

// 16. Previous Examination Papers
model PreviousPaper {
  id              String    @id
  universityId    String
  courseId        String
  semesterId      String
  subjectId       String
  examYear        Int
  examSession     String    @default("WINTER") // WINTER, SUMMER, REGULAR, REMEDIAL
  title           String?
  totalMarks      Int       @default(70)
  durationMinutes Int       @default(180)
  paperCode       String?
  fileUrl         String?
  allowDownload   Boolean   @default(true)
  status          String    @default("PUBLISHED") // DRAFT, AI_MAPPED, REVIEWED, PUBLISHED
  instructions    String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  university      University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course          Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semester        Semester   @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  subject         Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  paperQuestions  PreviousPaperQuestion[]

  @@unique([subjectId, examYear, examSession])
  @@index([universityId])
  @@index([subjectId])
  @@index([examYear])
  @@index([status])
}

// 17. Previous Paper Questions Junction
model PreviousPaperQuestion {
  id             String        @id @default(cuid())
  paperId        String
  questionId     String
  sectionName    String        @default("Section A")
  questionNumber String        @default("Q1")
  marks          Int           @default(14)
  isCompulsory   Boolean       @default(true)
  examYear       Int?
  mappingStatus  String        @default("VERIFIED") // AI_SUGGESTED, VERIFIED, MANUAL_OVERRIDE
  confidence     Float         @default(1.0)
  mappingNotes   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  paper          PreviousPaper @relation(fields: [paperId], references: [id], onDelete: Cascade)
  question       Question      @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([paperId])
  @@index([questionId])
  @@index([examYear])
  @@index([mappingStatus])
}

// 18. Mock Tests
model MockTest {
  id                 String    @id
  universityId       String?
  courseId           String?
  semesterId         String?
  subjectId          String?
  title              String
  description        String?
  durationMinutes    Int       @default(30)
  totalMarks         Int       @default(30)
  passingMarks       Int       @default(15)
  hasNegativeMarking Boolean   @default(true)
  negativeMarkValue  Float     @default(0.25)
  isPublished        Boolean   @default(true)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  university         University? @relation(fields: [universityId], references: [id], onDelete: SetNull)
  course             Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  semester           Semester?   @relation(fields: [semesterId], references: [id], onDelete: SetNull)
  subject            Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  
  questions          MockTestQuestion[]
  testAttempts       TestAttempt[]

  @@index([subjectId])
  @@index([universityId])
}

// 19. Mock Test Questions Junction
model MockTestQuestion {
  id         String   @id @default(cuid())
  mockTestId String
  mcqId      String
  orderIndex Int      @default(1)
  marks      Float    @default(1.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  mockTest   MockTest @relation(fields: [mockTestId], references: [id], onDelete: Cascade)
  mcq        Mcq      @relation(fields: [mcqId], references: [id], onDelete: Cascade)

  @@unique([mockTestId, mcqId])
  @@index([mockTestId])
  @@index([mcqId])
}

// 20. Test Attempts (Student exam and practice sessions)
model TestAttempt {
  id                String       @id @default(cuid())
  userId            String
  mockTestId        String?
  practiceMode      String       @default("TIMED_QUIZ") // TOPIC, UNIT, SUBJECT, MIXED, RANDOM, TIMED_QUIZ, MY_MISTAKES
  subjectId         String?
  unitId            String?
  topicId           String?
  score             Float        @default(0)
  totalQuestions    Int          @default(0)
  correctCount      Int          @default(0)
  incorrectCount    Int          @default(0)
  skippedCount      Int          @default(0)
  timeTakenSeconds  Int          @default(0)
  topicPerformance  String?      // JSON string storing per-topic accuracy and analytics
  completedAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())

  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mockTest          MockTest?    @relation(fields: [mockTestId], references: [id], onDelete: SetNull)
  answers           TestAnswer[]

  @@index([userId])
  @@index([mockTestId])
  @@index([practiceMode])
}

// 21. Test Answers (Per-question test responses)
model TestAnswer {
  id                String      @id @default(cuid())
  attemptId         String
  mcqId             String
  selectedOptionKey String?     // A, B, C, D
  isCorrect         Boolean     @default(false)
  timeSpentSeconds  Int         @default(0)
  createdAt         DateTime    @default(now())

  attempt           TestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  mcq               Mcq         @relation(fields: [mcqId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([mcqId])
}

// 22. Bookmarks (Saved materials)
model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  entityType String   // NOTE, CASE_LAW, LEGAL_SECTION, QUESTION, MCQ
  entityId   String
  notes      String?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([entityType, entityId])
}

// 23. Wrong Answers (Mistake Notebook)
model WrongAnswer {
  id                 String    @id @default(cuid())
  userId             String
  mcqId              String
  studentAnswer      String?
  mistakeCount       Int       @default(1)
  lastWrongAt        DateTime  @default(now())
  isResolved         Boolean   @default(false)
  reviewCount        Int       @default(0)
  correctReviewCount Int       @default(0)
  status             String    @default("NEED_REVISION") // NEED_REVISION, REVIEW_AGAIN, MASTERED
  lastReviewedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mcq                Mcq       @relation(fields: [mcqId], references: [id], onDelete: Cascade)

  @@unique([userId, mcqId])
  @@index([userId])
  @@index([isResolved])
  @@index([status])
}

// 24. Study Progress (Topic-level completion)
model StudyProgress {
  id               String   @id @default(cuid())
  userId           String
  topicId          String
  isCompleted      Boolean  @default(false)
  timeSpentSeconds Int      @default(0)
  confidenceLevel  String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  lastStudiedAt    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic            Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@index([topicId])
}

// 25. Student Subject Progress (Subject Mastery Level)
model StudentSubjectProgress {
  id                   String   @id @default(cuid())
  userId               String
  subjectId            String
  completionPercentage Float    @default(0.0)
  totalTopics          Int      @default(0)
  completedTopics      Int      @default(0)
  averageQuizScore     Float    @default(0.0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject              Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectId])
  @@index([userId])
  @@index([subjectId])
}

// 26. Revision Items (Spaced Repetition Schedule - SM2 & Leitner)
model RevisionItem {
  id                 String    @id @default(cuid())
  userId             String
  entityType         String    // TOPIC, CASE_LAW, LEGAL_SECTION, QUESTION, MCQ, NOTE
  entityId           String
  nextReviewAt       DateTime  @default(now())
  intervalDays       Int       @default(1)
  repetitionNumber   Int       @default(0)
  easeFactor         Float     @default(2.5)
  reviewCount        Int       @default(0)
  correctReviewCount Int       @default(0)
  revisionStatus     String    @default("NEED_REVISION") // NEED_REVISION, REVIEW_AGAIN, MASTERED
  lastReviewedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId])
  @@index([nextReviewAt])
  @@index([revisionStatus])
}

// 27. Study Plans (AI-Generated & Personalized Schedules)
model StudyPlan {
  id             String    @id @default(cuid())
  userId         String
  title          String
  targetExam     String
  targetExamDate DateTime?
  dailyHours     Float     @default(3.0)
  planDataJson   String    // JSON string containing day-by-day plan structure
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isActive])
}

// 28. AI Content (NyayaAI drafts, generation logs, and Admin verification)
// Workflow: AI_GENERATED -> DRAFT -> ADMIN_REVIEW -> VERIFIED -> PUBLISHED
model AiContent {
  id                 String    @id @default(cuid())
  entityType         String    // NOTES, SUMMARY, EXPLANATION, MCQ, MODEL_ANSWER, STUDY_PLAN
  prompt             String
  generatedContent   String
  language           String    @default("EN") // EN, GU, HI
  modelName          String    @default("gemini-1.5-flash")
  workflowStage      String    @default("AI_GENERATED") // AI_GENERATED, DRAFT, ADMIN_REVIEW, VERIFIED, PUBLISHED
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED, FLAGGED
  status             String    @default("DRAFT") // DRAFT, REVIEW, PUBLISHED (Never automatically published!)
  verifiedById       String?
  verificationNotes  String?
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  verifiedBy         User?     @relation("AiVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([entityType])
  @@index([workflowStage])
  @@index([verificationStatus])
  @@index([status])
  @@index([verifiedById])
}

// 29. Content Reviews (Faculty and Admin Audit Trail)
model ContentReview {
  id           String   @id @default(cuid())
  entityType   String   // NOTE, MCQ, CASE_LAW, QUESTION_ANSWER, LEGAL_SECTION, AI_CONTENT
  entityId     String
  reviewerId   String
  reviewStatus String   @default("APPROVED") // APPROVED, CHANGES_REQUESTED, REJECTED
  remarks      String?
  createdAt    DateTime @default(now())

  reviewer     User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([reviewerId])
  @@index([reviewStatus])
}

// 30. Answer Practice Attempts (Student Exam Writing Practice & AI Feedback)
model AnswerPracticeAttempt {
  id             String    @id @default(cuid())
  userId         String
  questionId     String
  studentAnswer  String
  evaluationJson String    // JSON containing AI Practice Feedback (10 checks, wellDone, missing, improve, flags)
  wordCount      Int       @default(0)
  timeSpentSecs  Int       @default(0)
  status         String    @default("SAVED") // SAVED, RETRIED, DRAFT
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question       Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questionId])
  @@index([status])
}

// =========================================================================
// 31. AUTOMATIC CURRENT SYLLABUS INTELLIGENCE SYSTEM
// Official Gujarat University Source Tracking, Diff Engine, Verification & Sync
// =========================================================================

// 31.1 Syllabus Sources (Authoritative University Repositories)
model SyllabusSource {
  id                    String    @id @default(cuid())
  universityId          String
  name                  String
  sourceType            String    @default("OFFICIAL_WEBSITE") // OFFICIAL_WEBSITE, CIRCULAR_PORTAL, ACADEMIC_SECTION, LAW_FACULTY, OFFICIAL_PDF
  url                   String
  circularUrl           String?
  academicSectionUrl    String?
  lawFacultyUrl         String?
  active                Boolean   @default(true)
  lastCheckedAt         DateTime?
  lastSuccessfulCheckAt DateTime?
  lastDocumentHash      String?
  checkFrequency        String    @default("DAILY") // HOURLY, DAILY, WEEKLY
  monitoringStatus      String    @default("HEALTHY") // HEALTHY, WARNING, ERROR, PAUSED
  lastErrorMessage      String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  university            University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  syncJobs              SyllabusSyncJob[]

  @@index([universityId])
  @@index([active])
  @@index([monitoringStatus])
}

// 31.2 Syllabus Versions (Versioned Academic Catalogs)
// Statuses: PENDING_REVIEW, VERIFIED_CURRENT, ARCHIVED, REJECTED
model SyllabusVersion {
  id                  String    @id @default(cuid())
  universityId        String
  collegeId           String?
  courseId            String?
  academicYear        String    // e.g. "2026-27"
  semesterNumber      Int       @default(1)
  version             String    @default("1.0")
  status              String    @default("PENDING_REVIEW") // PENDING_REVIEW, VERIFIED_CURRENT, ARCHIVED, REJECTED
  isCurrent           Boolean   @default(false)
  sourceUrl           String
  sourceDocumentUrl   String?
  sourceTitle         String?
  sourcePublishedDate DateTime?
  retrievedAt         DateTime  @default(now())
  verifiedAt          DateTime?
  verifiedById        String?
  contentHash         String
  confidenceScore     Float     @default(1.0)
  extractionNotes     String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  university          University @relation(fields: [universityId], references: [id], onDelete: Cascade)
  college             College?   @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  course              Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  verifiedBy          User?      @relation("SyllabusVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  syllabusSubjects    SyllabusSubject[]
  changes             SyllabusChange[]
  questions           Question[]
  mcqs                Mcq[]
  notifications       SyllabusNotification[]
  nyayaContexts       NyayaAIContext[]

  @@unique([universityId, collegeId, courseId, academicYear, semesterNumber, version])
  @@index([universityId])
  @@index([academicYear])
  @@index([semesterNumber])
  @@index([status])
  @@index([isCurrent])
}

// 31.3 Syllabus Subject Schema
model SyllabusSubject {
  id                String    @id @default(cuid())
  syllabusVersionId String
  subjectId         String?   // Link to active primary Subject
  title             String
  titleGu           String?
  code              String
  category          String    @default("Core Law")
  credits           Int       @default(4)
  marksTotal        Int       @default(100)
  marksExternal     Int       @default(70)
  marksInternal     Int       @default(30)
  sourcePage        Int?
  orderIndex        Int       @default(1)
  status            String    @default("VERIFIED") // VERIFIED, ADDED, MODIFIED, OUTDATED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  subject           Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  units             SyllabusUnit[]

  @@index([syllabusVersionId])
  @@index([code])
}

// 31.4 Syllabus Unit Schema
model SyllabusUnit {
  id                String    @id @default(cuid())
  syllabusSubjectId String
  unitNumber        Int       @default(1)
  title             String
  titleGu           String?
  description       String?
  sourcePage        Int?
  status            String    @default("VERIFIED")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  syllabusSubject   SyllabusSubject @relation(fields: [syllabusSubjectId], references: [id], onDelete: Cascade)
  topics            SyllabusTopic[]

  @@index([syllabusSubjectId])
}

// 31.5 Syllabus Topic Schema
model SyllabusTopic {
  id             String    @id @default(cuid())
  syllabusUnitId String
  topicNumber    Int       @default(1)
  title          String
  titleGu        String?
  description    String?
  confidence     Float     @default(1.0)
  sourcePage     Int?
  status         String    @default("VERIFIED") // VERIFIED, ADDED, MODIFIED, OUTDATED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  syllabusUnit   SyllabusUnit @relation(fields: [syllabusUnitId], references: [id], onDelete: Cascade)

  @@index([syllabusUnitId])
  @@index([status])
}

// 31.6 Syllabus Changes (Diff Records)
// Types: ADDED, REMOVED, MODIFIED, RENAMED, MOVED, UNCHANGED
model SyllabusChange {
  id                String    @id @default(cuid())
  syllabusVersionId String
  changeType        String    // ADDED, REMOVED, MODIFIED, RENAMED, MOVED, UNCHANGED
  entityType        String    // SUBJECT, UNIT, TOPIC, CREDITS, MARKS, GENERAL
  entityId          String?
  fieldName         String?
  oldValue          String?
  newValue          String?
  summary           String
  summaryGu         String?
  confidence        Float     @default(1.0)
  status            String    @default("PENDING_REVIEW") // PENDING_REVIEW, APPROVED, REJECTED
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())

  syllabusVersion   SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  reviewedBy        User?           @relation("SyllabusChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([syllabusVersionId])
  @@index([changeType])
  @@index([status])
}

// 31.7 Syllabus Sync Jobs (Automated & Manual Ingestion Runs)
model SyllabusSyncJob {
  id                String    @id @default(cuid())
  sourceId          String
  startedAt         DateTime  @default(now())
  completedAt       DateTime?
  status            String    @default("IN_PROGRESS") // IN_PROGRESS, SUCCESS, NO_CHANGE, FAILED, EXTRACTION_FAILED
  documentsFound    Int       @default(0)
  documentsChanged  Int       @default(0)
  changesDetected   Int       @default(0)
  documentUrl       String?
  documentHash      String?
  syllabusVersionId String?
  errorMessage      String?
  rawPayload        String?
  createdAt         DateTime  @default(now())

  source            SyllabusSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId])
  @@index([status])
  @@index([startedAt])
}

// 31.8 Student Syllabus Update Notifications
model SyllabusNotification {
  id                 String    @id @default(cuid())
  syllabusVersionId  String
  universityId       String
  courseId           String?
  semesterNumber     Int
  title              String
  titleGu            String?
  message            String
  messageGu          String?
  changesSummaryJson String?
  isRead             Boolean   @default(false)
  targetAudience     String    @default("ALL_STUDENTS") // ALL_STUDENTS, RELEVANT_STUDENTS, ADMINS
  createdAt          DateTime  @default(now())

  syllabusVersion    SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([syllabusVersionId])
}

// 31.9 NyayaAI Grounded Context Knowledge Store
model NyayaAIContext {
  id                 String    @id @default(cuid())
  syllabusVersionId  String
  universityId       String
  courseId           String?
  semesterNumber     Int
  subjectTitle       String
  unitTitle          String?
  topicTitle         String?
  contentSummary     String
  keyPrinciples      String?
  statutorySections  String?
  sourceCitation     String
  sourcePage         Int?
  isCurrent          Boolean   @default(true)
  verificationStatus String    @default("VERIFIED_CURRENT")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  syllabusVersion    SyllabusVersion @relation(fields: [syllabusVersionId], references: [id], onDelete: Cascade)
  university         University      @relation(fields: [universityId], references: [id], onDelete: Cascade)
  course             Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([universityId, semesterNumber, isCurrent])
  @@index([syllabusVersionId])
  @@index([subjectTitle])
}

// 31.10 Platform Audit Trail
model AuditLog {
  id         String    @id @default(cuid())
  userId     String?
  action     String    // SOURCE_CHECKED, DOCUMENT_DETECTED, DOCUMENT_DOWNLOADED, AI_EXTRACTED, CHANGE_DETECTED, ADMIN_REVIEWED, APPROVED, REJECTED, PUBLISHED, ARCHIVED, QUESTION_SYNCED
  entityType String    // SYLLABUS_VERSION, SYLLABUS_SOURCE, SYLLABUS_CHANGE, QUESTION, MCQ, NYAYAAI_CONTEXT
  entityId   String?
  oldValue   String?
  newValue   String?
  details    String?
  ipAddress  String?
  createdAt  DateTime  @default(now())

  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// 32. College & Institutional Enquiries / Leads
model CollegeInstitutionalEnquiry {
  id                     String    @id @default(cuid())
  fullName               String
  email                  String
  mobile                 String
  collegeName            String
  designation            String
  university             String?
  cityState              String?
  studentCount           Int
  preferredContactMethod String    @default("Email") // Email, Phone, WhatsApp
  description            String
  plan                   String    @default("college_institutional")
  planPrice              String    @default("499")
  billingCycle           String    @default("monthly")
  status                 String    @default("NEW") // NEW, CONTACTED, IN_DISCUSSION, CONVERTED, CLOSED
  ipAddress              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
}
